{
    "Serilog": {
        "Using": [ "Serilog.Sinks.MongoDB" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "Enrich": [ "FromLogContext" ],
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "./logs/log-.txt",
                    "rollingInterval": "Day"
                }
            },
            {
                "Name": "MongoDB",
                "Args": {
                    "databaseUrl": "",
                    "collectionName": "applogs"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "WebDatabase": ""
    },
    "ClientAuthentication": {
        "SecurityKey": "",
        "Issuer": "",
        "Audience": ""
    },
    "CloudinaryUrl": "",
    "GoogleAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": ""
    },
    "GithubAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": ""
    },
    "LineAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": ""
    },
    "AmazonImageBucket": ""
}